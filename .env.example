# NeuroSense web app — example environment
# The real .env is generated for you by Lovable Cloud. Copy this file to .env
# only when running the app outside Lovable.

# Backend (Supabase) — client-side, safe to expose
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-publishable-key>
VITE_SUPABASE_PROJECT_ID=<your-project-ref>

# Server-side only (never exposed to the browser).
# In Lovable these are stored as backend secrets, not in this file.

# URL of your Python training service, e.g. https://trainer.example.com/train
TRAINING_WEBHOOK_URL=

# Shared secret between the app and the Python service (must match ml/.env)
TRAINING_CALLBACK_SECRET=

# Public origin of this app, used to build the training callback URL
APP_ORIGIN=http://localhost:8080

# Lovable AI Gateway key for the Companion chatbot (managed automatically in Lovable)
LOVABLE_API_KEY=
