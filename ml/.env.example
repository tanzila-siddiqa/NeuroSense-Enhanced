# NeuroSense Python ML service
# Copy to ml/.env and fill in.

# Where this service reports training progress/results back to the app.
# Preview:   https://project--06d82103-ee45-41f0-9844-e892ea29d321-dev.lovable.app/api/public/training-callback
# Published: https://project--06d82103-ee45-41f0-9844-e892ea29d321.lovable.app/api/public/training-callback
NEUROSENSE_CALLBACK_URL=http://localhost:8080/api/public/training-callback

# Must be identical to the TRAINING_CALLBACK_SECRET secret stored in the app.
TRAINING_CALLBACK_SECRET=change-me

# Local dataset root (see ml/datasets/README.md for the folder layout)
DATASET_ROOT=./datasets

# Where trained model files are written
MODEL_DIR=./models

# Port for this service
PORT=9000
